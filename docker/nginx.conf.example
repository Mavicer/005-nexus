# ============================================================
# nginx 反向代理配置（R8 国内云部署）
# 部署到阿里云轻量应用服务器时：
#   1. 将此文件放到 /etc/nginx/conf.d/ 或 nginx.conf include
#   2. 替换 <YOUR_DOMAIN> 为备案域名
#   3. 用 certbot 或阿里云 SSL 配置 HTTPS
# 国内适配：CDN 回源到此，前端静态资源走国内 CDN
# ============================================================

# 压缩配置（R4 资源压缩）
gzip on;
gzip_vary on;
gzip_min_length 1024;
gzip_comp_level 6;
gzip_types
  text/plain
  text/css
  text/javascript
  application/javascript
  application/json
  application/xml
  image/svg+xml;

# 上游 Next.js 应用（next start + PM2，监听 3000）
upstream daxuexi_app {
  server 127.0.0.1:3000;
  keepalive 32;
}

server {
  listen 80;
  server_name <YOUR_DOMAIN>;

  # HTTP -> HTTPS 跳转（启用 HTTPS 后取消注释下方 listen 443 段）
  return 301 https://$host$request_uri;
}

server {
  listen 443 ssl http2;
  server_name <YOUR_DOMAIN>;

  # 证书路径（阿里云 SSL / Let's Encrypt）
  # ssl_certificate     /etc/ssl/certs/daxuexi.pem;
  # ssl_certificate_key /etc/ssl/private/daxuexi.key;

  # 安全头
  add_header X-Frame-Options "SAMEORIGIN" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;

  # 代理到 Next.js
  location / {
    proxy_pass http://daxuexi_app;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection "";
    proxy_read_timeout 60s;
  }

  # 静态资源长缓存（Next.js _next/static）
  location /_next/static/ {
    proxy_pass http://daxuexi_app;
    proxy_cache_valid 200 365d;
    add_header Cache-Control "public, max-age=31536000, immutable";
  }

  # 健康检查
  location = /health {
    access_log off;
    proxy_pass http://daxuexi_app/api/health;
  }
}
