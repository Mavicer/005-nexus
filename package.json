{
  "name": "nexus-developer-events",
  "version": "0.1.0",
  "private": true,
  "description": "面向计算机学生的开发实践赛事发现平台",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node scripts/start.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "admin:create": "node --import tsx scripts/admin.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:inventory": "node --import tsx scripts/inventory.ts",
    "db:import": "node --import tsx scripts/data/import.ts",
    "test:integration": "node --import tsx scripts/integration.ts",
    "legacy:plan": "node --import tsx scripts/data/legacy-plan.ts",
    "legacy:apply": "node --import tsx scripts/data/apply-legacy-map.ts",
    "test:http": "node --import tsx scripts/http-smoke.ts",
    "test:recommendation": "node --import tsx scripts/recommendation-test.ts",
    "build:cloudflare": "node scripts/build-cloudflare.mjs",
    "deploy": "opennextjs-cloudflare deploy",
    "preview:cloudflare": "opennextjs-cloudflare preview",
    "cf:typegen": "node scripts/cloudflare-types.mjs"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.3",
    "luxon": "3.7.2",
    "next": "16.4.3",
    "pg": "^8.22.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261030.1",
    "@eslint/compat": "^2.1.0",
    "@eslint/eslintrc": "^3.3.6",
    "@opennextjs/cloudflare": "^1.20.14",
    "@types/luxon": "3.7.6",
    "@types/node": "^22.10.0",
    "@types/pg": "8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.18.0",
    "eslint-config-next": "16.4.3",
    "postcss": "^8.5.0",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.10",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.1",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.156.0"
  },
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "overrides": {
    "sharp": "0.35.5"
  }
}
