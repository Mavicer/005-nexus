# ============================================================
# 大学学习通网站 — 环境变量示例
# 复制为 .env.local 本地开发使用，禁止提交真实密钥
# 国内适配说明：所有值在国内云环境（阿里云）下可解析
# ============================================================

# ---------- 应用 ----------
NODE_ENV=development
# 站点对外根 URL（部署后改为 https://你的备案域名）
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- 数据库 (PostgreSQL) ----------
# Docker Compose 内默认 postgres/postgres；生产用强密码并从环境注入
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/daxuexi
# 连接池参数（生产建议通过 DATABASE_URL 或单独配置）
# DATABASE_POOL_MAX=10

# ---------- 中文全文检索 (R3, P1 用 PostgreSQL pg_jieba) ----------
# 预留：未来切换到 Meilisearch 时启用
# MEILISEARCH_HOST=http://localhost:7700
# MEILISEARCH_MASTER_KEY=changeme

# ---------- 认证 / 用户系统 (P1 基础用户，预留) ----------
# JWT 或 session 密钥，生产随机长字符串
AUTH_SECRET=dev-only-change-me-to-a-long-random-string
# SESSION_SECRET=dev-only-change-me

# ---------- 部署 (R4/R8 国内云) ----------
# 云厂商：aliyun | tencent （默认 aliyun）
CLOUD_PROVIDER=aliyun
# 是否已备案（仅影响部署脚本提示，非功能开关）
ICP_FILED=false
# ICP 备案号（备案完成后填，渲染到页脚）
ICP_NUMBER=

# ---------- 监控 / 统计（国内源，R4） ----------
# 预留：百度统计 / 友盟，后续接入
# BAIDU_TONGJI_ID=
# UMENG_ID=
